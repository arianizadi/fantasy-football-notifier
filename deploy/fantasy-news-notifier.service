[Unit]
Description=Fantasy football news notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arian
WorkingDirectory=/home/arian/services/fantasy-news-notifier
ExecStart=/home/arian/services/fantasy-news-notifier/.venv/bin/python /home/arian/services/fantasy-news-notifier/bin/run-notifier.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fantasy-news-notify

# The process only needs its own state directory and outbound HTTPS.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/arian/services/fantasy-news-notifier/state

[Install]
WantedBy=multi-user.target
