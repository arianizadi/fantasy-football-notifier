# Copy to .env and chmod 600. Never commit real values.

# --- Telegram (create a bot with @BotFather, then message it once) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- OpenRouter ---
OPENROUTER_API_KEY=""
# Pinned GA release; avoid *-latest so an upstream swap cannot silently change
# classification behaviour mid-season.
OPENROUTER_MODEL="deepseek/deepseek-v4-flash-0731"

# --- Second opinion (threaded reply under the fast alert) ---
VERIFY_ENABLED="true"
VERIFY_MODEL="deepseek/deepseek-v4-pro"
# Only double-check calls at or above this severity.
VERIFY_MIN_SEVERITY="3"

# Free third opinion from whatever OpenRouter stealth model is currently live.
# Stealth models are unreleased models under a codename, free during a
# promotional window, then withdrawn. This discovers one at runtime and
# disables itself when none is published. Failures are ignored - it is free,
# so a model that cannot hold the JSON schema is simply skipped.
# Requires allowing unknown-retention models at openrouter.ai/settings/privacy.
STEALTH_REVIEW="true"

# VERIFY_MODEL may also be "auto" to use the winner of bin/eval-models.py.

# --- Leagues: configure ESPN, Sleeper, or both ---
ESPN_LEAGUE_ID=""
ESPN_YEAR="2026"
ESPN_SWID=""
ESPN_S2=""
# Optional; blank auto-detects your team by matching ESPN_SWID to the owner id.
ESPN_TEAM_ID=""

SLEEPER_USERNAME=""  # e.g. your_sleeper_username
# Optional; blank includes every NFL league that username plays in.
SLEEPER_LEAGUE_IDS=""

# --- Polling ---
# RotoWire's feed holds only 5 items and sends no cache validators, so every
# poll is a full fetch. Fast during NFL news windows, idle otherwise.
POLL_SECONDS="15"
POLL_SECONDS_IDLE="60"
ADAPTIVE_POLLING="true"

# --- Alert thresholds (1-5) ---
# Floor for players on your roster.
MIN_SEVERITY="2"
# Floor for rival-roster and general league news.
MIN_SEVERITY_OTHER="3"

# --- X / Twitter reporter stream (optional; pay-per-use, ~$0.005/post read) ---
# Verify handles and price them with bin/measure-reporters.py before adding.
TWITTER_BEARER_TOKEN=""

WATCH_TRENDING="true"
TRENDING_LIMIT="50"
# Auto-delete alerts this bot sent after N hours (0 = keep forever).
# Telegram refuses deletion past 48h, so this is capped at 47.
MESSAGE_TTL_HOURS="24"

DRY_RUN="false"
