# Copy to .env and chmod 600. Never commit real values.

# --- Telegram (create a bot with @BotFather, then message it once) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- OpenRouter ---
OPENROUTER_API_KEY=""
# Pinned GA release. Deliberately not *-latest: a live test of the latest
# alias returned severity 10 on a 1-5 scale, which is exactly the silent
# behaviour drift pinning avoids.
OPENROUTER_MODEL="deepseek/deepseek-v4-flash-0731"

# --- Embedding-assisted duplicate coalescing (uses the same OpenRouter key) ---
# off = no vector calls; shadow = score/log only; coalesce = safely edit an
# existing Telegram message when vectors AND deterministic transition guards agree.
EMBEDDING_MODE="off"
EMBEDDING_MODEL="qwen/qwen3-embedding-8b"
EMBEDDING_DIMENSIONS="512"
EMBEDDING_SIMILARITY_THRESHOLD="0.90"
EMBEDDING_WINDOW_HOURS="6"
EMBEDDING_TIMEOUT_SECONDS="8"
# Embedding starts beside classification; wait only this long if it is still running.
EMBEDDING_WAIT_MS="250"

# --- Leagues: configure ESPN, Sleeper, or both ---
ESPN_LEAGUE_ID=""
ESPN_YEAR="2026"
ESPN_SWID=""
ESPN_S2=""
# Optional; blank auto-detects your team by matching ESPN_SWID to the owner id.
ESPN_TEAM_ID=""

SLEEPER_USERNAME=""  # e.g. your_sleeper_username
# Optional; blank includes every NFL league that username plays in.
SLEEPER_LEAGUE_IDS=""

# --- Polling ---
# RotoWire's feed holds only 5 items and sends no cache validators, so every
# poll is a full fetch. Fast during NFL news windows, idle otherwise.
POLL_SECONDS="15"
POLL_SECONDS_IDLE="60"
ADAPTIVE_POLLING="true"

# --- Alert thresholds (1-5) ---
# Floor for players on your roster.
MIN_SEVERITY="2"
# Floor for rival-roster and general league news.
MIN_SEVERITY_OTHER="3"

# --- X / Twitter reporter stream (optional; usage-billed by X) ---
# Verify handles and current pricing before enabling the stream.
TWITTER_BEARER_TOKEN=""

# --- FantasyPros cached rankings (optional) ---
# Used only as scoring-specific WAIVER/ROS context. Breaking alerts and live
# ESPN/Sleeper ownership checks never wait for this provider.
FANTASYPROS_API_KEY=""
# Persistent rolling-24h application cap. Keep below the provider entitlement
# so retries, diagnostics, and reset-time uncertainty retain headroom.
FANTASYPROS_REQUEST_LIMIT="425"
# Four PPR/HALF WAIVER/ROS snapshots every two hours is about 48 requests/day.
FANTASYPROS_REFRESH_HOURS="2"
FANTASYPROS_MAX_AGE_HOURS="12"

# --- Telegram controls (handled by the long-running service) ---
# Enable only when this service is the sole getUpdates consumer for this bot
# token. Keep false when the token is also used by OpenClaw; use a dedicated
# notifier bot to enable commands and feedback safely.
TELEGRAM_CONTROLS_ENABLED="false"
# Keep reply chains inside the native one-week chat-retention window.
PLAYER_THREAD_HOURS="168"
DAILY_DIGEST_ENABLED="true"
# Morning recap of the prior rolling 24 hours: big news, smaller moves, and a
# short football-learning note. Breaking alerts still arrive immediately.
DAILY_DIGEST_HOUR="8"
DAILY_DIGEST_TIMEZONE="America/Los_Angeles"

# One full, league-specific pickup report per actual waiver-processing cohort.
# The provider timestamp is authoritative; this is not hard-coded to Tuesday.
WAIVER_REPORT_ENABLED="true"
WAIVER_REPORT_LEAD_HOURS="8"

DRY_RUN="false"
